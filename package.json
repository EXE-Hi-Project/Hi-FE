{
  "name": "@hi/web",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:desktop": "vite --mode desktop",
    "build": "npm run build:client && npm run build:prerender",
    "build:client": "tsc && vite build",
    "build:desktop": "tsc && vite build --mode desktop",
    "build:prerender": "vite build --ssr src/seo/prerender-entry.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "test": "vitest run",
    "audit:production": "audit-ci --config audit-ci.json",
    "test:seo": "node scripts/verify-seo.mjs",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.27",
    "@hookform/resolvers": "^5.5.7",
    "@iconify-icons/fluent-emoji-flat": "^1.2.9",
    "@iconify/react": "^6.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@react-oauth/google": "^0.12.2",
    "@stomp/stompjs": "^7.3.0",
    "@stripe/stripe-js": "^9.7.0",
    "@tanstack/react-query": "^5.12.0",
    "axios": "^1.18.1",
    "gsap": "^3.13.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.42.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-facebook-login": "^4.1.1",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.6.0",
    "react-is": "^19.2.4",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.0",
    "zod": "^3.22.4",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^6.0.4",
    "audit-ci": "^7.1.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "form-data": "^4.0.6"
  }
}
